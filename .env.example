# ============================================================================
# SecurePulse (Code-Guardian) — environment variables
# ============================================================================
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit `.env` — it is gitignored. For production, set these in the
# platform's project settings (Vercel / Cloudflare / your CI secret store).
#
# Classification:
#   [public]   Safe to ship to the browser. Must be `VITE_`-prefixed for Vite
#              to inline them into the client bundle.
#   [server]   Sensitive. Read via `process.env` in server-only modules
#              (server functions, API routes, middleware). Never `VITE_`-prefixed
#              and never referenced from client-shipped code.
# ============================================================================

# --- Supabase (public / publishable keys) -----------------------------------
# Browser-side Supabase client (auth + RLS queries). Vite inlines these at
# build time, so they MUST be set for every deployment (Vercel, Cloudflare).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (publishable) key — safe to expose to the browser.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase config. Server modules prefer these values and fall
# back to the matching VITE_ public values above for existing deployments.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# [server][SENSITIVE] Service-role key — bypasses RLS. Server-only.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI audit engine (Gemini) ------------------------------------------------
# [server][SENSITIVE] Server-only. Required for AI-powered scans, copilot,
# repository indexing, and agent operations; missing/invalid keys return a
# configuration error. Local instant scans do not require Gemini.
# Do not prefix this with VITE_; VITE_ variables are exposed in the browser.
# GOOGLE_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# --- GitHub App / webhooks ---------------------------------------------------
# [server][SENSITIVE] HMAC secret that verifies GitHub webhook deliveries.
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# --- Paddle billing ----------------------------------------------------------
# [server][SENSITIVE] Paddle API key used to create authenticated transactions.
# PADDLE_API_KEY=pdl_sandbox_apikey_xxxxx
# [server][SENSITIVE] Endpoint secret from the Paddle notification destination.
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxx
# Use Paddle monthly recurring price IDs; map each ID to its plan.
# PADDLE_STARTER_PRICE_ID=pri_xxxxx
# PADDLE_PRO_PRICE_ID=pri_yyyyy
# PADDLE_ENVIRONMENT=sandbox

# --- Secrets vault -----------------------------------------------------------
# [server][SENSITIVE] 32-byte base64 key used to encrypt vault entries. Rotate
# deliberately — entries become unrecoverable if changed.
# VAULT_ENCRYPTION_KEY=base64-encoded-32-bytes

# --- Observability -----------------------------------------------------------
# [server] Optional. If unset, telemetry stays a no-op.
# SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0

# --- Site canonical origin ---------------------------------------------------
# [server] Optional. Used by /sitemap.xml to emit absolute URLs. Falls back to
# the incoming request origin when unset (correct on preview domains too).
# SITE_URL=https://securepulse.example.com
# PUBLIC_SITE_URL=https://securepulse.example.com

# --- Test / CI only ----------------------------------------------------------
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=not-a-real-password
